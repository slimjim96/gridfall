<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 so it runs on this box; Core stays net8.0 for Godot. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gridfall.Verify</RootNamespace>
    <AssemblyName>Gridfall.Verify</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Gridfall.Core/Gridfall.Core.csproj" />
    <ProjectReference Include="../Gridfall.Io/Gridfall.Io.csproj" />
  </ItemGroup>

</Project>
